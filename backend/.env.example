DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tour_guard
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=tour-guard
JWT_AUDIENCE=tour-guard-app
ACCESS_TOKEN_MINUTES=30
OSRM_BASE_URL=https://router.project-osrm.org
HTTP_TIMEOUT_SECONDS=15
ROUTE_BUFFER_METERS=250
CORS_ORIGINS=["http://localhost:3000"]
HAZARD_COVERAGE_VERIFIED=false

# Enable only for local Flutter web development; keep false in production.
CORS_ALLOW_LOCALHOST=false
